{
  "name": "image-generation",
  "description": "Generate pixel art cat images using Stable Diffusion or FLUX (CPU/GPU compatible)",
  "author": "",
  "skillType": "image",
  "pythonScript": "image_gen.py",
  "envOptions": {
    "HEIGHT": {
      "type": "int",
      "default": 512,
      "description": "Image height"
    },
    "WIDTH": {
      "type": "int", 
      "default": 512,
      "description": "Image width"
    },
    "STEPS": {
      "type": "int",
      "default": 30,
      "description": "Number of inference steps"
    },
    "MODEL": {
      "type": "string",
      "default": "runwayml/stable-diffusion-v1-5",
      "description": "Model name (SD or FLUX)"
    }
  },
  "outputPath": "./cat_output/cat_{TIMESTAMP}.png"
}
