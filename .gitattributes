# Автоматическая нормализация строк
* text=auto

# Python файлы - всегда LF
*.py text eol=lf

# Другие текстовые файлы
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Бинарные файлы
*.png binary
*.jpg binary
*.pdf binary
