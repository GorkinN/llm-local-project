# Dockerfile.aider
FROM paulgauthier/aider:latest

# Проверяем, какой пользователь существует
# Обычно это root или app

# Устанавливаем модули
RUN pip install \
    black \
    flake8 \
    pytest \
    pytest-asyncio

# Не переключаем пользователя, оставляем как есть
WORKDIR /app

ENTRYPOINT ["aider"]